{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zana.local/schemas/permissions.schema.json",
  "title": "ZANA Permission Policy",
  "description": "Default-deny permission policy for ZANA capability sources. Omitted sections are deny-by-default: outbound network false, empty filesystem/tool/secret allowlists, and experimental MCP endpoints disabled.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "default": 1
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["offline", "ask"],
          "default": "offline"
        },
        "outbound": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "filesystem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "read": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "write": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        }
      }
    },
    "experimental": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mcp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "endpoints": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "endpoint"],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "endpoint": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "scopes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "default": []
                  },
                  "enabled": {
                    "type": "boolean",
                    "default": false
                  }
                }
              },
              "default": []
            }
          }
        }
      }
    }
  }
}
