{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zana.local/schemas/capability.schema.json",
  "title": "ZANA Capability Source Manifest",
  "description": "Canonical schema for editable zana.yaml capability source manifests (schemaVersion 1). additionalProperties is false at every boundary so unsupported fields, install hooks, and typos fail closed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "id", "name", "version"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "ZanaCapability"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "license": {
      "type": "string",
      "maxLength": 1000
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimumContextTokens": {
          "type": "integer",
          "minimum": 0
        },
        "requiredModelCapabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "primaryMetrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system"],
      "properties": {
        "system": {
          "$ref": "#/$defs/safePath"
        }
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": {
                "$ref": "#/$defs/safePath"
              }
            }
          }
        },
        "citationRequired": {
          "type": "boolean"
        }
      }
    },
    "training": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "optional": {
          "type": "boolean"
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "train": {
          "$ref": "#/$defs/safePath"
        },
        "validation": {
          "$ref": "#/$defs/safePath"
        },
        "minimumExamples": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest"],
      "properties": {
        "manifest": {
          "$ref": "#/$defs/safePath"
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy"],
      "properties": {
        "policy": {
          "$ref": "#/$defs/safePath"
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domain": {
          "$ref": "#/$defs/safePath"
        },
        "regression": {
          "$ref": "#/$defs/safePath"
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "domain": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "minimumAbsolute": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "minimumImprovement": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "regression": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "maximumDrop": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "safePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._/ -]+$"
    }
  }
}
